#!/bin/sh
# post-checkout hook - rebuild .pro from projections
# Run after checkout, branch switch, etc.

REPO_ROOT=$(git rev-parse --show-toplevel)
HOOKS_DIR="$REPO_ROOT/codesys-git-hooks"

if [ ! -d "$HOOKS_DIR" ]; then
  exit 0
fi

# Call the TypeScript hook implementation
node "$HOOKS_DIR/dist/post-checkout.js" "$REPO_ROOT" 2>/dev/null
exit 0
