{
  "scopeName": "source.st",
  "fileTypes": ["st"],
  "name": "Structured Text (IEC 61131-3)",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.st", "begin": "\\(\\*", "end": "\\*\\)" },
        { "name": "comment.line.double-slash.st", "begin": "//", "end": "$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.st", "begin": "'", "end": "'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.st", "match": "\\b(?:[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|16#[0-9A-Fa-f]+|2#[01]+|8#[0-7]+)\\b" },
        { "name": "constant.numeric.time.st", "match": "\\b[Tt]#[0-9]+(?:ms|s|m|h|d)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.st", "match": "\\b(?i:IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|RETURN)\\b" },
        { "name": "keyword.operator.st", "match": "\\b(?i:AND|OR|XOR|NOT|MOD|DIV)\\b" },
        { "name": "keyword.declaration.st", "match": "\\b(?i:VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_EXTERNAL|VAR_STAT|VAR_TEMP|END_VAR|PROGRAM|FUNCTION_BLOCK|FUNCTION|END_PROGRAM|END_FUNCTION_BLOCK|END_FUNCTION|ARRAY|OF|STRUCT|END_STRUCT)\\b" },
        { "name": "keyword.type.st", "match": "\\b(?i:BOOL|BYTE|WORD|DWORD|LWORD|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|REAL|LREAL|STRING|WSTRING|TIME|DATE|CHAR)\\b" },
        { "name": "constant.language.st", "match": "\\b(?i:TRUE|FALSE)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.st", "match": ":=" },
        { "name": "keyword.operator.comparison.st", "match": "<>|<=|>=|=|<|>" },
        { "name": "keyword.operator.arithmetic.st", "match": "[+\\-*/]" }
      ]
    }
  }
}